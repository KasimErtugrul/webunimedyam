<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Android 13+ (API 33+) bildirim izni zorunlu -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:label="UniTv"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">

            <meta-data
                android:name="io.flutter.embedding.android.NormalTheme"
                android:resource="@style/NormalTheme" />

            <!-- Launcher intent -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>

            <!--
                FCM bildirimine tıklanınca uygulamayı ön plana getiren intent.
                click_action: "FLUTTER_NOTIFICATION_CLICK" ile eşleşmelidir.
                singleTop + bu intent-filter sayesinde MainActivity yeniden
                oluşturulmaz; Flutter FCM plugin yeni mesajı mevcut activity'e iletir.
            -->
            <intent-filter>
                <action android:name="FLUTTER_NOTIFICATION_CLICK" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>

            <!--
                ESKİ ÖZEL ŞEMA (unitv://video/{videoId})
                Geriye dönük uyumluluk için korunuyor (bkz.
                lib/core/constants/app_links.dart -> customScheme).
                DİKKAT: WhatsApp/Telegram/Instagram gibi üçüncü parti
                uygulamalar bu şemayı OTOMATİK TIKLANABİLİR hale
                getirmez — bu yüzden artık paylaşım linki olarak
                KULLANILMIYOR (bkz. share_helper.dart). Sadece uygulama
                zaten yüklüyse ve link bir şekilde açılırsa çalışır.
            -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="unitv" android:host="video" />
            </intent-filter>

            <!--
                YENİ: ANDROID APP LINKS (https://{webHost}/video/{videoId})
                Paylaşımda kullanılan ve WhatsApp gibi uygulamalarda
                TIKLANABİLİR olan asıl link budur (bkz. share_helper.dart,
                lib/core/constants/app_links.dart -> webHost).

                android:autoVerify="true" ile Android, uygulama kurulduğunda
                bu domain'in /.well-known/assetlinks.json dosyasını
                otomatik kontrol eder ve doğrulama başarılıysa bu linkler
                tarayıcıya hiç uğramadan doğrudan uygulamayı açar.

                ÖNEMLİ: Aşağıdaki android:host değerini kendi Firebase
                Hosting domain'inle DEĞİŞTİR (lib/core/constants/app_links.dart
                içindeki webHost ile BİREBİR AYNI olmalı).
            -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="https"
                    android:host="unitv-33f05.web.app"
                    android:pathPrefix="/video" />
            </intent-filter>

        </activity>

        <!-- FCM: Arka plan bildirimleri için varsayılan kanal ID'si -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="high_importance_channel" />

        <!-- FCM: Bildirim simgesi (beyaz/şeffaf PNG, drawable klasöründen).
             BUG FIX: Daha önce burada @mipmap/ic_launcher (renkli logo)
             kullanılıyordu — Android bildirim ikonlarını tek renkli silüet
             olarak render ettiğinden bu, durum çubuğunda düz beyaz bir
             leke/kare gibi görünüyordu. ic_launcher_foreground'dan üretilen
             beyaz silüet (ic_stat_notify) burada kullanılıyor. -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@drawable/ic_stat_notify" />

        <!-- Flutter embedding -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />

    </application>

    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
        <!-- Android 11+ (API 30+) paket görünürlüğü: url_launcher'ın
             canLaunchUrl/launchUrl ile http(s) linklerini (YouTube vb.)
             açabilmesi için bu sorgular gereklidir; yoksa canLaunchUrl
             her zaman false döner ve tıklama sessizce hiçbir şey yapmaz. -->
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <category android:name="android.intent.category.BROWSABLE" />
            <data android:scheme="https" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <category android:name="android.intent.category.BROWSABLE" />
            <data android:scheme="http" />
        </intent>
    </queries>
</manifest>
